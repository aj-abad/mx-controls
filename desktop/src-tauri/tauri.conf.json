{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MX Studio",
  "version": "0.1.0",
  "identifier": "app.mxcontrols.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm agent && pnpm generate",
    "beforeBundleCommand": "pnpm mac-icon",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MX Studio",
        "width": 1124,
        "height": 632,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": true,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mx-agent"
    ],
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/Assets.car": "target/mac-icon/Assets.car"
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
